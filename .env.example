# Copy this file to `.env.local` (gitignored) and adjust paths for your machine,
# or export these variables directly in your shell.

# Directory containing clang, ld.lld, and llvm-readelf (LLVM 16+ recommended)
# macOS (Apple Silicon Homebrew): /opt/homebrew/opt/llvm/bin
# macOS (Intel Homebrew):         /usr/local/opt/llvm/bin
# Linux:                          /usr/bin (or leave unset if clang is on PATH)
A7R3_LLVM_BIN=/path/to/llvm/bin

# Directory containing legally extracted A7R3 v3.10 runtime libs from your camera/firmware:
# libc-2.11.2.so, libdl-2.11.2.so, libpthread-2.11.2.so
# (If you run `python tools/a7r3_addon_console.py init-camera`, they are saved to `./firmware/lib` and auto-detected!)
A7R3_FW_LIB_DIR=/path/to/your/a7r3_v310_extraction/lib

# Optional developer override for ma1co/Sony-PMCA-RE (`pmca` directory).
# Leave commented out to use the built-in minimal MIT subset at `tools/vendor/pmca/`.
# A7R3_PMCA_DIR=/path/to/Sony-PMCA-RE

# Optional: explicit path to locally extracted viewStlrec.uxc for enabling Dual-HUD
# (Auto-detected near A7R3_FW_LIB_DIR, or generate via `gen_dual_hud_payload.py --from-camera`)
# A7R3_UXC_PATH=/path/to/a7r3_v310_extraction/usr/share/app/viewStlrec.uxc

# Optional: CJK TrueType/Collection fonts for tools/gen_md3_assets.py (only needed for MD3 build)
# A7R3_FONT_BOLD=/System/Library/Fonts/PingFang.ttc
# A7R3_FONT_REG=/System/Library/Fonts/PingFang.ttc
