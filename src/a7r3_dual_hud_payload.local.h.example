#ifndef A7R3_DUAL_HUD_PAYLOAD_LOCAL_H
#define A7R3_DUAL_HUD_PAYLOAD_LOCAL_H

#include <stdint.h>

/*
 * Optional locally-supplied RecordPtr payload for Simultaneous Level + Histogram HUD.
 *
 * To comply with copyright and clean-room policies, NO Sony layout binary data
 * is distributed in this repository. Advanced developers who have legally
 * extracted and patched their own ILCE-7RM3 v3.10 resource `0x02008029` (outer
 * LEVEL layout) may copy this file to `src/a7r3_dual_hud_payload.local.h`
 * (gitignored) and populate `payload[]` with their locally generated bytes.
 *
 * When `a7r3_dual_hud_payload.local.h` is absent, `a7r3_dual_hud.c` builds
 * cleanly in pass-through mode (keeping PB DISP mode tracking intact).
 */

#define A7R3_DUAL_HUD_PAYLOAD_LEN 2380u

static const struct {
    uint32_t tag; /* Bit 31 clear (0x00000000u) -> inline RecordPtr data at +4 */
    uint8_t payload[A7R3_DUAL_HUD_PAYLOAD_LEN];
} __attribute__((aligned(4))) g_dual_level_rec = {
    0x00000000u,
    {
        /* Populate locally extracted/patched 2380-byte resource 0x02008029 here. */
        0x00
    }
};

#endif /* A7R3_DUAL_HUD_PAYLOAD_LOCAL_H */
